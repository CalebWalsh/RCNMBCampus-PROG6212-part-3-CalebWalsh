@model ProfileVm
@{
    ViewData["Title"] = "Profile";
    string initial = string.IsNullOrWhiteSpace(Model.FullName) ? "R" : Model.FullName.Trim().Substring(0, 1).ToUpperInvariant();
}
<div class="container">
    <div class="page-head">
        <div>
            <h1>Profile</h1>
            <p>Update your details and profile picture.</p>
        </div>
    </div>

    <div class="panel mb-5">
        <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ProfileImageUrl" />
            <input type="hidden" asp-for="ClubId" />
            <div class="row g-4">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                    {
                        <img class="profile-photo" src="@Model.ProfileImageUrl" alt="Your profile picture" />
                    }
                    else
                    {
                        <div class="profile-photo-ph mx-auto" aria-hidden="true">@initial</div>
                    }
                    <div class="mt-3 text-start">
                        <label asp-for="Picture" class="form-label"></label>
                        <input asp-for="Picture" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Picture" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-4">Save profile</button>
                </div>
            </div>
        </form>
    </div>
</div>
