@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My events";
}
<div class="container">
    <div class="page-head">
        <div>
            <h1>My events</h1>
            <p>Events you have entered and their enrolment status.</p>
        </div>
        <a class="btn btn-primary" asp-action="Index">Browse events</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <strong>You have not entered an event yet.</strong>
            Browse upcoming events and pick a category to enter.
        </div>
    }
    else
    {
        <div class="table-wrap table-responsive">
            <table class="table rd-table">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var en in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @if (en.EventId > 0)
                                {
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@en.EventId">@en.EventName</a>
                                }
                                else
                                {
                                    @en.EventName
                                }
                            </td>
                            <td>@Display.Date(en.EventDate)</td>
                            <td>@en.CategoryName</td>
                            <td><partial name="_StatusBadge" model="en.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
