@model EnrolmentsVm
@{
    ViewData["Title"] = "Enrolments";
}
<div class="container">
    <div class="page-head">
        <div>
            <h1>Enrolments</h1>
            <p>Participants enrolled in each of your events.</p>
        </div>
    </div>

    @if (Model.Selected == null)
    {
        <div class="empty-state">
            <strong>Create an event first.</strong>
            Enrolments appear here once participants enter your events.
        </div>
    }
    else
    {
        <form method="get" asp-action="Enrolments" class="filter-bar row g-2 align-items-end">
            <div class="col-md-8">
                <label for="eventId" class="form-label">Event</label>
                <select id="eventId" name="eventId" class="form-select" onchange="this.form.submit()">
                    @foreach (var e in Model.Events)
                    {
                        <option value="@e.Id" selected="@(e.Id == Model.Selected.Id)">@e.Name (@Display.Date(e.EventDate))</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><button type="submit" class="btn btn-ink w-100">Show enrolments</button></div>
        </form>

        @if (Model.Enrolments.Count == 0)
        {
            <div class="empty-state">
                <strong>No enrolments yet.</strong>
                Nobody has entered @Model.Selected.Name so far.
            </div>
        }
        else
        {
            <div class="table-wrap table-responsive">
                <table class="table rd-table">
                    <thead><tr><th>Participant</th><th>Category</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var en in Model.Enrolments)
                        {
                            <tr>
                                <td class="fw-semibold">@en.ParticipantName</td>
                                <td>@en.CategoryName</td>
                                <td><partial name="_StatusBadge" model="en.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-2 text-muted">@Model.Enrolments.Count enrolled</p>
        }
    }
</div>
