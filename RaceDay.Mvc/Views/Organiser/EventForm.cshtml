@model EventFormVm
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}
<div class="container">
    <div class="page-head">
        <h1>@(isNew ? "Create event" : "Edit event")</h1>
        <a class="btn btn-outline-secondary" asp-action="Events">Back to events</a>
    </div>

    <div class="panel mb-5">
        <form asp-action="@(isNew ? "CreateEvent" : "EditEvent")" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BannerImageUrl" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Running">Running</option>
                        <option value="Walking">Walking</option>
                        <option value="Cycling">Cycling</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.BannerImageUrl" alt="Current event banner" class="thumb" style="width:160px;height:90px;" />
                            <div class="form-text">Choose a new image to replace the current banner.</div>
                        </div>
                    }
                    <input asp-for="Banner" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="Banner" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(isNew ? "Create event" : "Save changes")</button>
                <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
            </div>
        </form>
    </div>
</div>
