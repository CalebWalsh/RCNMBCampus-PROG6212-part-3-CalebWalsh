@model List<EventDto>
@{
    ViewData["Title"] = "Events";
}
<div class="container">
    <div class="page-head">
        <div>
            <h1>Events</h1>
            <p>Create, edit and delete the events you organise.</p>
        </div>
        <a class="btn btn-primary" asp-action="CreateEvent">Create event</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <strong>No events yet.</strong>
            Events you create will appear here.
        </div>
    }
    else
    {
        <div class="table-wrap table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(e.BannerImageUrl))
                                {
                                    <img class="thumb" src="@e.BannerImageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="thumb-ph" aria-hidden="true">@Display.TypeIcon(e.EventType)</span>
                                }
                            </td>
                            <td class="fw-semibold"><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">@e.Name</a></td>
                            <td>@Display.Date(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td>@Display.Distance(e.DistanceKm) km</td>
                            <td><span class="type-tag mt-0">@e.EventType</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@e.Id">Edit</a>
                                <a class="btn btn-sm btn-ink" asp-action="Categories" asp-route-eventId="@e.Id">Categories</a>
                                <form asp-action="DeleteEvent" asp-route-id="@e.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
