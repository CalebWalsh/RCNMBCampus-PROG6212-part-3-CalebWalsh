@model ParticipantHomeVm
@{
    ViewData["Title"] = "Upcoming events";
    string[] types = { "Running", "Walking", "Cycling" };
}
<div class="container">
    <div class="page-head">
        <div>
            <h1>Upcoming events</h1>
            <p>Find an event, check the categories and enter.</p>
        </div>
    </div>

    <form method="get" asp-action="Index" class="filter-bar row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label">Name or location</label>
            <input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Johannesburg" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in types)
                {
                    <option value="@t" selected="@(string.Equals(Model.Type, t, StringComparison.OrdinalIgnoreCase))">@t</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Apply filters</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>

    @if (Model.Events.Count == 0)
    {
        <div class="empty-state">
            <strong>No events match.</strong>
            Clear the filters or check back when organisers add new events.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var e in Model.Events)
            {
                <div class="col-md-6 col-xl-4"><partial name="_EventCard" model="e" /></div>
            }
        </div>
    }
</div>
