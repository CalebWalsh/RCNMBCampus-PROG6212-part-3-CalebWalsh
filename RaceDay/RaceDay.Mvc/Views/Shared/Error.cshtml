@{
    ViewData["Title"] = ViewData["Heading"] ?? "Something went wrong";
}
<div class="container py-5">
    <div class="panel text-center mx-auto" style="max-width: 36rem;">
        <h1>@ViewData["Heading"]</h1>
        <p class="lead mt-3">@ViewData["Message"]</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>
